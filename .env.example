# Copy this to .env (same directory as docker-compose.yml) and fill in the
# real key(s). .env is gitignored — never commit your actual values.
#
# Only needed for AI job scoring (POST /api/jobs/score). Job search, the
# CV upload/edit pages, and everything else work without this set.
ANTHROPIC_API_KEY=sk-ant-...

# Required. Signs login sessions (JWT) — set this to a long random string
# in production (e.g. `openssl rand -hex 32`). If you don't set it, the
# backend falls back to an insecure hardcoded dev value, which means
# anyone can forge login tokens for your deployment.
JWT_SECRET=change-me-to-a-random-value
