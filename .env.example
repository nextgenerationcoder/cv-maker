# Copy this to .env (same directory as docker-compose.yml) and fill in the
# real key(s). .env is gitignored — never commit your actual values.
#
# Fallback key for AI job scoring (POST /api/jobs/score) and the CV
# tailoring feature (/api/tailoring/*), used only for a user who hasn't
# added their own key on the Settings page (frontend/settings.html).
# Job search and the CV upload/edit pages work without this set.
ANTHROPIC_API_KEY=sk-ant-...

# Optional tailoring tuning — sensible defaults if unset.
# TAILOR_LLM_MODEL=claude-opus-5
# TAILOR_PASS_SCORE=75
# TAILOR_MAX_REVISIONS=2
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Required. Signs login sessions (JWT) — set this to a long random string
# in production (e.g. `openssl rand -hex 32`). If you don't set it, the
# backend falls back to an insecure hardcoded dev value, which means
# anyone can forge login tokens for your deployment.
JWT_SECRET=change-me-to-a-random-value
